---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Versions from '../../components/Versions.astro';
import Parts from '../../components/Parts.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft && p.body?.trim());
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, date, thumbnail, links, achievements, hero, heroCaption } = project.data;
// Hero: one image or several side by side; falls back to the thumbnail.
const heroList = hero === false ? [] : hero ? [hero].flat() : thumbnail ? [thumbnail] : [];
// Design iterations, if src/content/versions/<id>.yaml exists.
const versions = (await getCollection('versions')).find((v) => v.id === project.id);
// Curriculum + gallery, if src/content/parts/<id>.yaml exists.
const parts = (await getCollection('parts')).find((p) => p.id === project.id);
const linkList = [
  links.repo && { label: 'Code', href: links.repo },
  links.demo && { label: 'Demo', href: links.demo },
  links.paper && { label: 'Paper', href: links.paper },
].filter(Boolean) as { label: string; href: string }[];
---
<Base title={title} description={summary}>
  <p class="back"><a href="/">← {site.name}</a></p>
  <article class="project-page">
    <h1>{title}</h1>
    <p class="meta">
      {[...tags, date].join(' · ')}
    </p>
    {linkList.length > 0 && (
      <p class="links">{linkList.map((l) => <a href={l.href}>{l.label}</a>)}</p>
    )}
    {project.data.achievements.length > 0 && (
      <ul class="achievements">
        {project.data.achievements.map((a) => <li>{a}</li>)}
      </ul>
    )}
    {heroList.length > 0 && (
      <figure
        class="hero"
        style={`--n: ${heroList.length}`}
        data-match={heroList.length === 2 && heroList.filter(Array.isArray).length === 1 ? '' : undefined}
      >
        <div class="hero-grid">
          {heroList.map((item, i) =>
            Array.isArray(item) ? (
              <div class="hero-stack">
                {item.map((src, j) => <Media src={src} alt={`${title} ${i + 1}.${j + 1}`} id={`hero-${i + 1}-${j + 1}`} data-zoom />)}
              </div>
            ) : (
              <Media src={item} alt={`${title} ${i + 1}`} id={`hero-${i + 1}`} data-zoom />
            ),
          )}
        </div>
        {heroCaption && <figcaption class="meta">{heroCaption}</figcaption>}
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
    {versions && <Versions data={versions.data} />}
    {parts && <Parts data={parts.data} />}
  </article>
</Base>

<script>
  // Hero with one image + one stack of squares: size the columns so both are the same height.
  for (const fig of document.querySelectorAll<HTMLElement>('.hero[data-match]')) {
    const grid = fig.querySelector<HTMLElement>('.hero-grid')!;
    const stack = grid.querySelector<HTMLElement>('.hero-stack')!;
    const single = [...grid.children].find((c) => c !== stack) as HTMLImageElement | HTMLVideoElement;
    if (stack.firstElementChild !== null && single === grid.lastElementChild) grid.classList.add('stack-first');
    const fit = () => {
      const w = 'naturalWidth' in single ? single.naturalWidth : single.videoWidth;
      const h = 'naturalHeight' in single ? single.naturalHeight : single.videoHeight;
      if (!w || !h) return;
      grid.style.setProperty('--r', String(w / h));
      grid.style.setProperty('--k', String(stack.children.length));
      grid.classList.add('matched');
    };
    fit();
    single.addEventListener('load', fit);
    single.addEventListener('loadedmetadata', fit);
  }
</script>
