---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Versions from '../../components/Versions.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft && p.body?.trim());
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, date, thumbnail, links, achievements, hero, heroCaption } = project.data;
// Hero: one image or several side by side; falls back to the thumbnail.
const heroList = hero ? [hero].flat() : thumbnail ? [thumbnail] : [];
// Design iterations, if src/content/versions/<id>.yaml exists.
const versions = (await getCollection('versions')).find((v) => v.id === project.id);
const linkList = [
  links.repo && { label: 'Code', href: links.repo },
  links.demo && { label: 'Demo', href: links.demo },
  links.paper && { label: 'Paper', href: links.paper },
].filter(Boolean) as { label: string; href: string }[];
---
<Base title={title} description={summary}>
  <p class="back"><a href="/">← {site.name}</a></p>
  <article class="project-page">
    <h1>{title}</h1>
    <p class="meta">
      {[...tags, date].join(' · ')}
    </p>
    {linkList.length > 0 && (
      <p class="links">{linkList.map((l) => <a href={l.href}>{l.label}</a>)}</p>
    )}
    {project.data.achievements.length > 0 && (
      <ul class="achievements">
        {project.data.achievements.map((a) => <li>{a}</li>)}
      </ul>
    )}
    {heroList.length > 0 && (
      <figure class="hero" style={`--n: ${heroList.length}`}>
        <div class="hero-grid">
          {heroList.map((src, i) => <Media src={src} alt={`${title} ${i + 1}`} data-zoom />)}
        </div>
        {heroCaption && <figcaption class="meta">{heroCaption}</figcaption>}
      </figure>
    )}
    {versions && <Versions data={versions.data} />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
