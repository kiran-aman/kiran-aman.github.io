---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft && p.body?.trim());
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, date, thumbnail, links } = project.data;
const linkList = [
  links.repo && { label: 'Code', href: links.repo },
  links.demo && { label: 'Demo', href: links.demo },
  links.paper && { label: 'Paper', href: links.paper },
].filter(Boolean) as { label: string; href: string }[];
---
<Base title={title} description={summary}>
  <p class="back"><a href="/">← {site.name}</a></p>
  <article class="project-page">
    <h1>{title}</h1>
    <p class="meta">
      {[...tags, date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' })].join(' · ')}
    </p>
    {linkList.length > 0 && (
      <p class="links">{linkList.map((l) => <a href={l.href}>{l.label}</a>)}</p>
    )}
    {thumbnail && <Media class="hero" src={thumbnail} alt={title} />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
