---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Media from '../components/Media.astro';
import { site } from '../site';

const year = (s: string) =>
  /present/i.test(s) ? 9999 : Math.max(0, ...(s.match(/\d{4}/g) ?? []).map(Number));

const all = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => year(b.data.date) - year(a.data.date),
);
const featured = all.filter((p) => p.data.featured);
const other = all.filter((p) => !p.data.featured);

const hasPage = (p: (typeof all)[number]) => Boolean(p.body?.trim());
const hrefFor = (p: (typeof all)[number]) =>
  hasPage(p) ? `/projects/${p.id}/` : p.data.links.repo ?? p.data.links.demo;
---
<Base>
  <Header />
  <section class="about">
    {site.about.trim().split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
  </section>

  {featured.length > 0 && (
    <section>
      <h2>Projects</h2>
      <ul class="project-list">
        {featured.map((p) => (
          <li class="project">
            <a class="thumb" href={hrefFor(p)} tabindex="-1">
              <Media src={p.data.thumbnail} alt={p.data.title} />
            </a>
            <div>
              <h3><a href={hrefFor(p)}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
              {p.data.achievements.length > 0 && (
                <ul class="achievements">
                  {p.data.achievements.map((a) => <li>{a}</li>)}
                </ul>
              )}
              <p class="meta">
                {[...p.data.tags, p.data.date].join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {other.length > 0 && (
    <section>
      <h2>Other work</h2>
      <ul class="gallery">
        {other.map((p) => {
          const href = hrefFor(p);
          const Tag = href ? 'a' : 'div';
          return (
            <li>
              <Tag class="tile" href={href}>
                <Media src={p.data.thumbnail} alt={p.data.title} />
                <span class="tile-title">{p.data.title}</span>
                <span class="meta">{p.data.summary}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</Base>
