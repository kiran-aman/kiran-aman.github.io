---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Media from '../components/Media.astro';
import { site } from '../site';
import { inlineMarkdown as md } from '../lib/markdown.mjs';

const year = (s: string) =>
  /present/i.test(s) ? 9999 : Math.max(0, ...(s.match(/\d{4}/g) ?? []).map(Number));

const all = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) =>
    b.data.order - a.data.order ||
    year(b.data.date) - year(a.data.date),
);

const featured = all.filter((p) => p.data.featured);
const other = all.filter((p) => !p.data.featured);

const hasPage = (p: (typeof all)[number]) => Boolean(p.body?.trim());
const hrefFor = (p: (typeof all)[number]) =>
  hasPage(p) ? `/projects/${p.id}/` : p.data.links.repo ?? p.data.links.demo;
---
<Base>
  <Header />
  <section class="about">
    {site.about.trim().split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
  </section>

  {featured.length > 0 && (
    <section>
      <h2>Projects</h2>
      <ul class="project-list">
        {featured.map((p) => (
          <li class="project">
            <a class="thumb" href={hrefFor(p)} tabindex="-1">
              <Media src={p.data.thumbnail} alt={p.data.title} />
            </a>
            <div>
              <h3><a href={hrefFor(p)}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
              {p.data.achievements.length > 0 && (
                <ul class="achievements">
                  {p.data.achievements.map((a) => <li>{a}</li>)}
                </ul>
              )}
              <p class="meta">
                {[...p.data.tags, p.data.date].join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {other.length > 0 && (
    <section class="other-work">
      <h2>Other work</h2>
      <div class="masonry">
        {other.map((p) => {
          const href = hrefFor(p);
          const media = [p.data.thumbnail, ...p.data.images].filter(Boolean) as string[];
          const linkList = [
            hasPage(p) && { label: 'Details', href: `/projects/${p.id}/` },
            p.data.links.repo && { label: 'Code', href: p.data.links.repo },
            p.data.links.demo && { label: 'Demo', href: p.data.links.demo },
            p.data.links.paper && { label: 'Paper', href: p.data.links.paper },
          ].filter(Boolean) as { label: string; href: string }[];
          return (
            <article class="part">
              {media.length > 0 && (
                <div class="part-photo">
                  <Media
                    src={media[0]}
                    alt={p.data.title}
                    data-zoom
                    data-gallery={JSON.stringify(media)}
                    data-caption={p.data.title}
                  />
                  {media.length > 1 && <span class="more-count">+{media.length - 1}</span>}
                </div>
              )}
              <h3>{href ? <a href={href}>{p.data.title}</a> : p.data.title}</h3>
              <p class="part-meta">{[...p.data.tags, p.data.date].join(' · ')}</p>
              <div class="part-summary" set:html={md(p.data.summary)} />
              {linkList.length > 0 && (
                <p class="links">{linkList.map((l) => <a href={l.href}>{l.label}</a>)}</p>
              )}
            </article>
          );
        })}
      </div>
    </section>
  )}
</Base>
